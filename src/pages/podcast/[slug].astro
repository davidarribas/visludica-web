---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEpisodes } from '../../lib/rss';
import { sanitizeRssHtml, formatEpisodeHtml } from '../../lib/rss-html.mjs';
import { LISTEN_PLATFORMS } from '../../config';

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  return episodes.map(ep => ({
    params: { slug: ep.slug },
    props: { episode: ep },
  }));
}

const { episode } = Astro.props;

const formattedDate = episode.pubDate.toLocaleDateString('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const platformLinks = [
  ...LISTEN_PLATFORMS.filter((p) => ['spotify', 'apple', 'ivoox'].includes(p.icon)).map((p) => ({
    href: p.href,
    label: p.label,
    external: true,
  })),
  { href: '/escuchar/', label: 'Todas las plataformas', external: false },
];
---

<BaseLayout
  title={episode.title}
  description={episode.description}
  image={episode.imageUrl || '/logo.png'}
  type="article"
>
  <article class="section">
    <div class="container episode-layout">

      <aside class="episode-sidebar">
        {episode.imageUrl && (
          <img
            src={episode.imageUrl}
            alt={episode.title}
            class="episode-cover"
            width="280"
            height="280"
          />
        )}
        <div class="episode-meta-box">
          <div class="meta-row">
            <span class="meta-label">Fecha</span>
            <time datetime={episode.pubDate.toISOString()}>{formattedDate}</time>
          </div>
          {episode.duration && (
            <div class="meta-row">
              <span class="meta-label">Duración</span>
              <span>{episode.duration}</span>
            </div>
          )}
        </div>
        <div class="platform-links">
          <p class="meta-label">Escuchar en</p>
          <ul>
            {platformLinks.map(p => (
              <li><a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined}>{p.label} ↗</a></li>
            ))}
          </ul>
        </div>
      </aside>

      <div class="episode-main">
        <a href="/podcast/" class="back-link">← Todos los episodios</a>
        <h1>{episode.title}</h1>

        <!-- Player de Captivate -->
        <div class="player-wrap">
          <iframe
            src={`https://player.captivate.fm/episode/${episode.captivateId}`}
            title={`Reproductor: ${episode.title}`}
            width="100%"
            height="200"
            frameborder="0"
            scrolling="no"
            loading="lazy"
          ></iframe>
        </div>

        <!-- Descripción / shownotes -->
        {episode.content && (
          <div class="prose episode-content" set:html={formatEpisodeHtml(sanitizeRssHtml(episode.content))} />
        )}
      </div>

    </div>
  </article>
</BaseLayout>

<style>
.episode-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: var(--space-12);
  align-items: start;
}

@media (max-width: 900px) {
  .episode-layout {
    grid-template-columns: 1fr;
  }
  .episode-sidebar {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .episode-cover { width: 100% !important; }
}

@media (max-width: 540px) {
  .episode-sidebar { grid-template-columns: 1fr; }
}

/* Sidebar */
.episode-sidebar { display: flex; flex-direction: column; gap: var(--space-6); }

.episode-cover {
  width: 280px;
  height: 280px;
  border: var(--border);
  object-fit: cover;
  box-shadow: var(--shadow-lg);
}

.episode-meta-box {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4);
  background: var(--color-surface);
  border: var(--border);
  box-shadow: var(--shadow-md);
}
.meta-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  font-family: var(--font-mono);
  font-size: var(--text-meta);
}
.meta-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--fw-bold);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
}

.platform-links { display: flex; flex-direction: column; gap: var(--space-2); }
.platform-links ul {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.platform-links a {
  font-size: var(--text-sm);
  font-weight: var(--fw-semibold);
  color: var(--color-accent);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
  transition: color var(--transition);
}
.platform-links a:hover { color: var(--color-accent-hover); }

/* Main */
.episode-main { display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; }

.back-link {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  min-height: 44px;
  padding: var(--space-1) var(--space-4);
  border: var(--border-thin);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  color: var(--color-text);
  font-size: var(--text-sm);
  font-weight: var(--fw-bold);
}
.back-link:hover { color: var(--color-text); background: var(--color-surface-raised); }

.episode-main h1 {
  font-size: clamp(2rem, 4vw, 2.75rem);
  line-height: 1;
}
@media (max-width: 640px) {
  .episode-main h1 { font-size: var(--text-2xl); }
}

.player-wrap {
  overflow: hidden;
  background: var(--color-surface);
  border: var(--border);
  box-shadow: var(--shadow-md);
}
.player-wrap iframe { display: block; }

.episode-content { margin-top: var(--space-2); }
</style>
