---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { getEpisodes, paginateEpisodes } from '../../lib/rss';

const PAGE_SIZE = 24;
const episodes = await getEpisodes();
const { items, totalPages, currentPage } = paginateEpisodes(episodes, 1, PAGE_SIZE);
---

<BaseLayout
  title="Podcast"
  description={`Todos los episodios de Vis Lúdica. ${episodes.length} episodios sobre juegos de mesa, eurogames y análisis en profundidad.`}
>
  <section class="section">
    <div class="container">
      <header class="page-header">
        <span class="label">Archivo</span>
        <h1>Todos los episodios</h1>
        <p class="page-desc">
          {episodes.length} episodios y contando. Análisis, reseñas,
          mecánicas y conversaciones sobre eurogames.
        </p>
      </header>

      <div class="episode-search">
        <label for="episode-search-input" class="sr-only">Buscar episodio</label>
        <input
          type="search"
          id="episode-search-input"
          placeholder="Buscar episodio…"
          autocomplete="off"
          data-episode-search
        />
        <p class="episode-search__status" data-search-status hidden></p>
      </div>

      <div class="search-results" data-search-results hidden></div>

      <div class="episode-grid" data-episode-grid>
        {items.map(ep => <EpisodeCard episode={ep} />)}
      </div>

      {totalPages > 1 && (
        <nav class="pagination" data-pagination aria-label="Paginación">
          <span class="pagination__current">Página 1 de {totalPages}</span>
          <a href="/podcast/pagina/2" class="btn btn-outline">
            Siguientes episodios →
          </a>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  interface IndexedEpisode {
    titulo: string;
    slug: string;
    fecha: string;
    duracion: string;
    resumen: string;
  }

  const input = document.querySelector<HTMLInputElement>('[data-episode-search]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const resultsContainer = document.querySelector<HTMLElement>('[data-search-results]');
  const grid = document.querySelector<HTMLElement>('[data-episode-grid]');
  const pagination = document.querySelector<HTMLElement>('[data-pagination]');

  if (input) {
    let episodes: IndexedEpisode[] | null = null;
    let loading = false;

    // Normalización idéntica a la del buscador del ranking (sin acentos, minúsculas).
    function normalizeSearch(value: string) {
      return value
        .toLocaleLowerCase('es')
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '');
    }

    const dateFormatter = new Intl.DateTimeFormat('es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    async function ensureLoaded() {
      if (episodes || loading) return;
      loading = true;
      try {
        const res = await fetch('/podcast/indice.json');
        episodes = await res.json();
      } catch {
        episodes = [];
      }
      loading = false;
      runSearch();
    }

    function renderResults(matches: IndexedEpisode[]) {
      if (!resultsContainer) return;
      resultsContainer.innerHTML = '';
      matches.slice(0, 50).forEach((ep) => {
        const link = document.createElement('a');
        link.href = `/podcast/${ep.slug}`;
        link.className = 'search-result-card';

        const time = document.createElement('time');
        time.dateTime = ep.fecha;
        time.className = 'search-result-card__date text-xs text-secondary';
        time.textContent = dateFormatter.format(new Date(ep.fecha));

        const title = document.createElement('h3');
        title.className = 'search-result-card__title';
        title.textContent = ep.titulo;

        link.append(time, title);

        if (ep.resumen) {
          const desc = document.createElement('p');
          desc.className = 'search-result-card__desc text-secondary';
          desc.textContent = ep.resumen;
          link.append(desc);
        }

        resultsContainer.append(link);
      });
    }

    function restoreStatic() {
      if (resultsContainer) {
        resultsContainer.hidden = true;
        resultsContainer.innerHTML = '';
      }
      if (status) {
        status.hidden = true;
        status.textContent = '';
      }
      if (grid) grid.hidden = false;
      if (pagination) pagination.hidden = false;
    }

    function runSearch() {
      const raw = input!.value.trim();

      if (raw.length < 2) {
        restoreStatic();
        return;
      }

      // Índice aún no disponible: se reintenta cuando termine de cargar.
      if (!episodes) return;

      const query = normalizeSearch(raw);
      const matches = episodes.filter(
        (ep) =>
          normalizeSearch(ep.titulo).includes(query) ||
          normalizeSearch(ep.resumen).includes(query)
      );

      if (grid) grid.hidden = true;
      if (pagination) pagination.hidden = true;
      if (resultsContainer) resultsContainer.hidden = false;
      if (status) status.hidden = false;

      renderResults(matches);

      if (status) {
        status.textContent =
          matches.length === 0
            ? `No hay episodios que coincidan con «${raw}».`
            : `${matches.length} resultado${matches.length === 1 ? '' : 's'}`;
      }
    }

    input.addEventListener('focus', ensureLoaded, { once: true });
    input.addEventListener('input', () => {
      ensureLoaded();
      runSearch();
    });
  }
</script>

<style>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.page-header {
  margin-bottom: var(--space-10);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.page-header h1 { max-width: 600px; }
.page-desc {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  max-width: 560px;
}

.episode-search {
  margin-bottom: var(--space-6);
}
.episode-search input {
  width: min(420px, 100%);
  min-height: 44px;
  padding: 0 var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
  color: var(--color-text);
}
.episode-search input:focus {
  border-color: var(--color-accent);
  outline: 2px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
}
.episode-search__status {
  margin-top: var(--space-3);
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
}

.search-results {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-10);
}
.search-result-card {
  display: block;
  padding: var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: box-shadow var(--transition), border-color var(--transition);
}
.search-result-card:hover {
  color: inherit;
  box-shadow: var(--shadow-md);
  border-color: var(--color-border-strong);
}
.search-result-card__date {
  display: block;
}
.search-result-card__title {
  margin-top: var(--space-1);
  font-size: var(--text-base);
  font-weight: var(--fw-bold);
  line-height: 1.3;
  color: var(--color-text);
}
.search-result-card__desc {
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  line-height: 1.5;
}

.episode-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-10);
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--space-8);
  border-top: 1px solid var(--color-border);
}
.pagination__current {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}
</style>
