---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada (404)"
  description="La página que buscas no existe o ha cambiado de dirección."
  noCanonical
>
  <section class="section">
    <div class="container not-found">
      <p class="not-found__code">404</p>
      <h1>Página no encontrada</h1>
      <p class="not-found__text">
        La dirección que has abierto no existe o ha cambiado. Puedes continuar desde aquí:
      </p>
      <div class="not-found__links">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-outline" href="/noticias/">Ver noticias</a>
        <a class="btn btn-outline" href="/podcast/">Escuchar el podcast</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 560px;
    text-align: center;
  }
  .not-found__code {
    font-size: var(--text-5xl);
    font-weight: var(--fw-bold);
    color: var(--color-text-tertiary);
    line-height: 1;
  }
  .not-found h1 {
    margin-top: var(--space-3);
  }
  .not-found__text {
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
