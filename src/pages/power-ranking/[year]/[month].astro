---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PowerRankingExperience from '../../../components/PowerRankingExperience.astro';
import { editions } from '../../../lib/power-ranking';

export function getStaticPaths() {
  return editions.map((edition) => ({
    params: {
      year: String(edition.year),
      month: String(edition.month).padStart(2, '0'),
    },
    props: { edition },
  }));
}

const { edition } = Astro.props;
---

<BaseLayout
  title={`Power Ranking — ${edition.monthName} ${edition.year}`}
  description={`Resultados, histórico y crónica del Power Ranking de ${edition.monthName} de ${edition.year}.`}
>
  <PowerRankingExperience edition={edition} />
</BaseLayout>
