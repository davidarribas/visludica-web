---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LISTEN_PLATFORMS } from '../config';

// Descripciones propias de esta página (no se centralizan, solo href/label/color/icon).
const descriptions: Record<string, string> = {
  Spotify: 'Escuchar en Spotify',
  'Apple Podcasts': 'Escuchar en Apple Podcasts',
  iVoox: 'Escuchar en iVoox',
  YouTube: 'Ver en YouTube',
  'Feed RSS': 'Suscribirse con tu app favorita',
};

const platforms = LISTEN_PLATFORMS.map((p) => ({ ...p, desc: descriptions[p.label] ?? p.label }));
---

<BaseLayout
  title="Escuchar el podcast"
  description="Todas las plataformas donde puedes escuchar Vis Lúdica, el podcast de juegos de mesa."
>
  <section class="section listen-section">
    <div class="container listen-wrap">

      <header class="listen-header">
        <img src="/logo.png" alt="Vis Lúdica" class="listen-logo" width="96" height="96" />
        <h1>Escuchar Vis Lúdica</h1>
        <p>Más de 300 episodios sobre juegos de mesa. Elige tu plataforma favorita.</p>
      </header>

      <ul class="platform-list">
        {platforms.map(p => (
          <li>
            <a
              href={p.href}
              class="platform-btn"
              style={`--platform-color: ${p.color}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="platform-icon" aria-hidden="true">
                {p.icon === 'spotify' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                )}
                {p.icon === 'apple' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.54 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
                )}
                {p.icon === 'ivoox' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 4.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zm0 3a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zm0 2.25a2.25 2.25 0 1 1 0 4.5 2.25 2.25 0 0 1 0-4.5z"/></svg>
                )}
                {p.icon === 'youtube' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                )}
                {p.icon === 'rss' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
                )}
              </span>
              <span class="platform-label">{p.desc}</span>
              <svg class="platform-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 13L13 3M13 3H7M13 3v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <footer class="listen-footer">
        <a href="/podcast">Ver todos los episodios →</a>
      </footer>

    </div>
  </section>
</BaseLayout>

<style>
.listen-section {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 64px);
  padding-block: var(--space-16);
}

.listen-wrap {
  max-width: 520px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-8);
}

.listen-header {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}
.listen-logo {
  border-radius: var(--radius-xl);
  object-fit: cover;
  box-shadow: var(--shadow-md);
}
.listen-header h1 { font-size: var(--text-2xl); }
.listen-header p  { color: var(--color-text-secondary); font-size: var(--text-base); }

.platform-list {
  list-style: none;
  padding: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.platform-btn {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-5);
  background: var(--color-surface);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  color: var(--color-text);
  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  width: 100%;
}
.platform-btn:hover {
  border-color: var(--platform-color);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--platform-color) 12%, transparent);
  transform: translateY(-1px);
  color: var(--color-text);
}

.platform-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: color-mix(in srgb, var(--platform-color) 12%, transparent);
  color: var(--platform-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.platform-icon svg { width: 22px; height: 22px; }

.platform-label {
  flex: 1;
  font-weight: var(--fw-medium);
  font-size: var(--text-base);
}

.platform-arrow {
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  transition: color var(--transition), transform var(--transition);
}
.platform-btn:hover .platform-arrow {
  color: var(--platform-color);
  transform: translate(2px, -2px);
}

.listen-footer {
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
  width: 100%;
  text-align: center;
}
.listen-footer a {
  font-size: var(--text-sm);
  color: var(--color-accent);
  font-weight: var(--fw-medium);
}
.listen-footer a:hover { color: var(--color-accent-hover); }
</style>
