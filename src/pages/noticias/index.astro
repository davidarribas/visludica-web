---
import { getCollection } from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  NEWS_PAGE_SIZE,
  paginateNews,
  sortNewsByPublishedAt,
  toNewsCardViewModel,
} from '../../lib/news';

const newsEntries = sortNewsByPublishedAt(await getCollection('news'));
const { items, totalPages } = paginateNews(newsEntries, 1, NEWS_PAGE_SIZE);
const news = items.map(toNewsCardViewModel);
---

<BaseLayout
  title="Noticias"
  description="Novedades sobre publicaciones de juegos de mesa en español."
>
  <section class="section">
    <div class="container">
      <header class="news-header">
        <span class="label">Actualidad</span>
        <h1>Noticias</h1>
        <p>Una selección de novedades sobre publicaciones de juegos de mesa en español.</p>
      </header>

      <div class="news-list">
        {news.map((item) => <NewsCard news={item} />)}
      </div>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Paginación de noticias">
          <span class="pagination__current">Página 1 de {totalPages}</span>
          <a href="/noticias/pagina/2" class="btn btn-outline" rel="next">
            Siguientes noticias →
          </a>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<style>
.news-header {
  display: flex;
  max-width: 680px;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-10);
}
.news-header p {
  color: var(--color-text-secondary);
  font-size: var(--text-lg);
}
.news-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  max-width: 860px;
}
.pagination {
  display: flex;
  max-width: 860px;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--space-8);
  margin-top: var(--space-10);
  border-top: 1px solid var(--color-border);
}
.pagination__current {
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
}
</style>
