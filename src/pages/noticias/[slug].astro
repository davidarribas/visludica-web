---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDuration, formatPlayers, formatPrice, formatProductContext, formatPublishedDate,
  gameTypeLabels, type NewsProduct,
} from "../../lib/news";

interface Props { news: CollectionEntry<"news">; }
interface FactRow { label: string; value: string; href?: string; }

function productFactRows(product: NewsProduct): FactRow[] {
  const rows: FactRow[] = [];
  const players = formatPlayers(product);
  const duration = formatDuration(product);
  const price = formatPrice(product.price_eur);

  if (players) rows.push({ label: "Jugadores", value: players });
  if (duration) rows.push({ label: "Duración", value: duration });
  if (product.age_min) rows.push({ label: "Edad", value: `${product.age_min}+` });
  if (price) rows.push({ label: "PVPR", value: price });
  if (product.designers) rows.push({ label: "Diseño", value: product.designers.join(", ") });
  if (product.publisher_es) rows.push({ label: "Editorial", value: product.publisher_es });
  if (product.distributor_es) rows.push({ label: "Distribución", value: product.distributor_es });
  if (product.language) rows.push({ label: "Idioma", value: product.language });
  if (product.parent) rows.push({ label: "Juego base", value: product.parent });
  if (product.bgg_id) rows.push({
    label: "BGG",
    value: String(product.bgg_id),
    href: `https://boardgamegeek.com/boardgame/${product.bgg_id}`,
  });
  rows.push({ label: "Tipo", value: gameTypeLabels[product.type] });
  return rows;
}

export async function getStaticPaths() {
  return (await getCollection("news")).map((news) => ({
    params: { slug: news.id }, props: { news },
  }));
}

const { news } = Astro.props;
const { Content } = await render(news);
const productContext = formatProductContext(news.data.products);
const products = news.data.products.map((product, position) => ({ product, position, rows: productFactRows(product) }));
const publishedAt = news.data.published_at.toISOString();
const publishedDate = formatPublishedDate(news.data.published_at);
---

<BaseLayout
  title={news.data.title}
  description={news.data.summary}
  image={news.data.image?.src}
  type="article"
>
  <article class="section">
    <div class="container news-detail">
      <a href="/noticias/" class="back-link">← Volver a Noticias</a>
      <header class="news-detail__header">
        <h1>{news.data.title}</h1>
        <p class="news-detail__summary">{news.data.summary}</p>
        <p class="news-detail__publication">
          Publicado el <time datetime={publishedAt}>{publishedDate}</time>
        </p>
      </header>

      {news.data.image && (
        <img src={news.data.image.src} alt={news.data.image.alt} class="news-detail__image" decoding="async" />
      )}
      {news.data.products.length > 1 && <p class="news-detail__product-context">{productContext}</p>}
      <div class="prose news-detail__body"><Content /></div>

      <div class:list={["news-products", { "news-products--multiple": products.length > 1 }]}>
        {products.map(({ product, position, rows }) => (
          <section class="news-product" aria-labelledby={`product-${position}`} data-product-position={position}>
            <h2 id={`product-${position}`}>{product.name}</h2>
            <dl>{rows.map((row) => <div><dt>{row.label}</dt><dd>{row.href
              ? <a href={row.href} target="_blank" rel="noopener noreferrer">{row.value}</a>
              : row.value}</dd></div>)}</dl>
          </section>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
.news-detail { max-width: 900px; }
.back-link { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: var(--space-8); padding: var(--space-1) var(--space-4); border: var(--border-thin); background: var(--color-surface); box-shadow: var(--shadow-sm); color: var(--color-text); font-size: var(--text-sm); font-weight: var(--fw-bold); }
.back-link:hover { color: var(--color-text); background: var(--color-surface-raised); }
.news-detail__header h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; }
.news-detail__header { display: flex; max-width: 780px; flex-direction: column; gap: var(--space-4); }
.news-detail__summary { max-width: var(--measure); color: var(--color-text-secondary); font-family: var(--font-serif); font-size: clamp(1.25rem, 2.2vw, 1.5rem); font-weight: var(--fw-regular); line-height: 1.45; text-wrap: pretty; }
.news-detail__publication { color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: var(--text-meta); text-transform: uppercase; }
.news-detail__image { display: block; width: 100%; height: clamp(320px, 60vw, 560px); padding: var(--space-4); margin-top: var(--space-8); background: var(--color-surface); border: var(--border); box-shadow: var(--shadow-lg); object-fit: contain; }
.news-detail__product-context { margin-top: var(--space-6); color: var(--color-text-secondary); font-size: var(--text-sm); font-weight: var(--fw-medium); }
.news-detail__body { margin-top: var(--space-8); }
.news-products { display: grid; gap: var(--space-5); max-width: 780px; margin-top: var(--space-8); }
.news-product { padding: 0 var(--space-5) var(--space-5); background: var(--color-surface); border: var(--border); box-shadow: var(--shadow-md); }
.news-product h2 { margin: 0 calc(-1 * var(--space-5)) var(--space-4); padding: var(--space-3) var(--space-5); border-bottom: var(--border); background: var(--color-surface-raised); color: var(--color-text); font-size: var(--text-xl); line-height: 1.1; }
.news-product dl { display: grid; gap: var(--space-2); }
.news-product dl div { display: grid; grid-template-columns: minmax(120px, 0.38fr) 1fr; gap: var(--space-4); padding-top: var(--space-2); border-top: 1px solid var(--color-border); }
.news-product dl div:first-child { border-top: 0; padding-top: 0; }
.news-product dt { color: var(--color-text); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--fw-bold); text-transform: uppercase; padding-top: 0.15em; }
.news-product dd { color: var(--color-text); font-size: var(--text-sm); font-weight: var(--fw-medium); }
.news-product dd a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.15em; }
.news-product dd a:hover { color: var(--color-accent-hover); }
@media (min-width: 760px) { .news-products--multiple { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: none; } }
</style>
