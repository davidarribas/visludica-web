---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import CommunityCard from '../components/CommunityCard.astro';
import { getEpisodes, getFeedMeta } from '../lib/rss';
import { SITE, COMMUNITY_LINKS, SISTER_SITES } from '../config';
import { latestEdition, formatIndex, gameTitle } from '../lib/power-ranking';
import PowerRankingParticipation from '../components/PowerRankingParticipation.astro';

const [episodes, meta] = await Promise.all([getEpisodes(), getFeedMeta()]);
const latestEpisode = episodes[0];
const recentEpisodes = episodes.slice(1, 4);
const rankingProject = latestEdition.projects['vis-ludica'];
const rankingTop = rankingProject.rankings.power.slice(0, 3);
const communityLink = (label: string) => COMMUNITY_LINKS.find((l) => l.label === label)!;
const sisterLink = (label: string) => SISTER_SITES.find((l) => l.label === label)!;
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
>

  <!-- Hero -->
  <section class="hero section">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="label">Podcast de juegos de mesa</span>
        <h1>Vis Ludica</h1>
        <p class="hero-tagline">{SITE.tagline}</p>
        <p class="hero-note">Conversaciones sobre juegos modernos, estrategia y cultura de mesa.</p>
        <div class="hero-ctas">
          <a href="/podcast/" class="btn btn-primary">Ver todos los episodios</a>
          <a href="#comunidad" class="hero-secondary-link">Síguenos donde quieras →</a>
        </div>
      </div>
      {meta.imageUrl && (
        <div class="hero-image">
          <img src={meta.imageUrl} alt="Vis Ludica podcast" width="400" height="400" />
        </div>
      )}
    </div>
  </section>

  <!-- Último episodio -->
  {latestEpisode && (
    <section class="section-sm">
      <div class="container">
        <div class="section-header">
          <span class="label">Último episodio</span>
        </div>
        <EpisodeCard episode={latestEpisode} featured={true} />
      </div>
    </section>
  )}

  <!-- Episodios recientes -->
  {recentEpisodes.length > 0 && (
    <section class="section-sm">
      <div class="container">
        <div class="section-header">
          <h2>Episodios recientes</h2>
          <a href="/podcast/" class="section-link">Ver todos →</a>
        </div>
        <div class="episodes-list">
          {recentEpisodes.map(ep => (
            <EpisodeCard episode={ep} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Power Ranking -->
  <section class="section ranking-feature-section">
    <div class="container">
      <a href="/power-ranking/" class="ranking-feature">
        <div class="ranking-feature__copy">
          <span class="label">Resultados publicados · Power Ranking · {latestEdition.monthName} {latestEdition.year}</span>
          <h2>Los juegos que están sobre la mesa</h2>
          <p>{rankingProject.stats.voters} votantes deciden la clasificación viva de la comunidad. Consulta el Power, el ranking del mes y la carrera anual.</p>
          <span class="ranking-feature__link">Ver la clasificación completa →</span>
        </div>
        <ol class="ranking-feature__podium">
          {rankingTop.map((row, index) => (
            <li>
              <span>{index + 1}</span>
              <div>
                <strong>{gameTitle(rankingProject, row.id)}</strong>
                <small>Índice {formatIndex(row.score)}</small>
              </div>
            </li>
          ))}
        </ol>
      </a>
      <PowerRankingParticipation />
    </div>
  </section>

  <!-- Comunidad -->
  <section class="section community-section" id="comunidad">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="label">Comunidad</span>
          <h2>Encuéntranos aquí</h2>
        </div>
      </div>
      <div class="community-grid">
        <CommunityCard
          href={communityLink('Telegram').href}
          label={communityLink('Telegram').label}
          description="El grupo principal donde se reune la comunidad. Noticias, análisis y conversación sobre juegos de mesa."
          icon={communityLink('Telegram').icon}
          accent={communityLink('Telegram').accent}
        />
        <CommunityCard
          href={communityLink('YouTube').href}
          label={communityLink('YouTube').label}
          description="Más de 7.000 suscriptores. Vídeos de análisis, partidas comentadas y directos."
          icon={communityLink('YouTube').icon}
          accent={communityLink('YouTube').accent}
        />
        <CommunityCard
          href={communityLink('Destroquelar').href}
          label={communityLink('Destroquelar').label}
          description="La newsletter. Reflexiones largas sobre el hobby que no caben en un episodio."
          icon={communityLink('Destroquelar').icon}
          accent={communityLink('Destroquelar').accent}
        />
        <CommunityCard
          href={communityLink('Twitch').href}
          label={communityLink('Twitch').label}
          description="Directos con partidas en vivo, presentaciones de novedades y charlas sin guión."
          icon={communityLink('Twitch').icon}
          accent={communityLink('Twitch').accent}
        />
      </div>
      <div class="community-more">
        <a href="/comunidad/" class="section-link">Ver todos los espacios →</a>
      </div>
    </div>
  </section>

  <!-- Campamento Barton -->
  <section class="section-sm barton-section">
    <div class="container">
      <div class="barton-card">
        <div class="barton-text">
          <span class="label">Evento anual presencial</span>
          <h2>Campamento Barton</h2>
          <p>Cuatro días para encontrarnos en persona, jugar sin prisa y disfrutar de los juegos de mesa. Ediciones anuales con aforo limitado.</p>
          <a
            href={sisterLink('Barton').href}
            class="btn btn-outline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Más información ↗
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* Hero */
.hero {
  background: var(--color-surface-raised);
  border-bottom: var(--border);
}
.hero.section { padding-block: var(--space-20); }
.hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 620px) auto;
  gap: var(--space-16);
  align-items: center;
  justify-content: space-between;
}
@media (max-width: 768px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-image { display: none; }
  .hero.section { padding-block: var(--space-16); }
}

.hero-text { display: flex; flex-direction: column; gap: var(--space-4); max-width: 600px; }
.hero h1 {
  font-size: clamp(3.25rem, 8vw, 5.75rem);
  line-height: 0.95;
  color: var(--color-accent);
  text-shadow: 4px 4px 0 var(--brand-pink);
}
.hero-tagline {
  max-width: 520px;
  font-size: var(--text-xl);
  font-weight: var(--fw-bold);
  color: var(--color-text);
  line-height: 1.4;
}
.hero-note {
  max-width: 480px;
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.hero-ctas {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-top: var(--space-2);
}
.hero-secondary-link {
  font-size: var(--text-base);
  font-weight: var(--fw-bold);
  color: var(--color-accent);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 4px;
}
.hero-secondary-link:hover { color: var(--color-accent-hover); }

.hero-image img {
  width: 280px;
  height: 280px;
  border: var(--border);
  object-fit: cover;
  box-shadow: 10px 10px 0 0 var(--brand-pink);
  transform: rotate(2deg);
}

@media (max-width: 640px) {
  .hero h1 { font-size: 3.25rem; }
  .hero-ctas {
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-3);
  }
}

/* Secciones */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}
.section-link {
  font-size: var(--text-sm);
  font-weight: var(--fw-bold);
  color: var(--color-accent);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 4px;
  white-space: nowrap;
}
.section-link:hover { color: var(--color-accent-hover); }

.episodes-list { display: flex; flex-direction: column; gap: var(--space-5); }

/* Comunidad */
.community-section {
  background: var(--color-surface-raised);
  border-block: var(--border);
  /* compensa la altura del header sticky en el scroll */
  scroll-margin-top: calc(var(--header-height) + 8px);
}
.community-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-5);
}
@media (max-width: 640px) {
  .community-grid { grid-template-columns: 1fr; }
}
.community-more {
  margin-top: var(--space-6);
  text-align: right;
}

/* Power Ranking */
.ranking-feature-section { background: var(--color-surface); }
.ranking-feature {
  display: grid;
  grid-template-columns: 1fr minmax(360px, .8fr);
  gap: var(--space-12);
  align-items: center;
  padding: var(--space-10);
  border: var(--border);
  background: var(--color-pop-soft);
  box-shadow: var(--shadow-lg);
  transition: transform var(--transition), box-shadow var(--transition);
}
.ranking-feature:hover {
  color: inherit;
  transform: translate(-2px, -2px);
  box-shadow: 8px 8px 0 0 var(--shadow-color);
}
.ranking-feature + :global(.participation-card) { margin-top: var(--space-8); }
.ranking-feature__copy h2 { margin-top: var(--space-3); }
.ranking-feature__copy p { max-width: 600px; margin-top: var(--space-4); color: var(--color-text-secondary); }
.ranking-feature__link { display: inline-block; margin-top: var(--space-6); padding: var(--space-2) var(--space-4); border: var(--border); background: var(--color-pop); color: var(--color-on-pop); box-shadow: var(--shadow-sm); font-size: var(--text-sm); font-weight: var(--fw-bold); }
.ranking-feature__podium { display: flex; flex-direction: column; gap: var(--space-3); list-style: none; padding: 0; }
.ranking-feature__podium li { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); border: var(--border); background: var(--color-surface); box-shadow: var(--shadow-sm); }
.ranking-feature__podium li:nth-child(2) { margin-left: var(--space-5); }
.ranking-feature__podium li:nth-child(3) { margin-left: var(--space-10); }
.ranking-feature__podium li > span { display: grid; place-items: center; width: 40px; height: 40px; flex: 0 0 auto; border: var(--border); background: var(--color-surface-raised); color: var(--color-accent); font-family: var(--font-display); font-size: var(--text-xl); }
.ranking-feature__podium li:first-child > span { background: var(--brand-blue); color: #fff; }
.ranking-feature__podium strong, .ranking-feature__podium small { display: block; }
.ranking-feature__podium strong { line-height: 1.35; }
.ranking-feature__podium small { margin-top: 2px; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: var(--text-xs); }
@media (max-width: 800px) {
  .ranking-feature { grid-template-columns: 1fr; gap: var(--space-8); padding: var(--space-6); }
}

/* Barton */
.barton-section { background: var(--color-surface); }
.barton-card {
  background: var(--color-surface);
  border: var(--border);
  border-left: 10px solid var(--brand-blue);
  box-shadow: var(--shadow-lg);
  padding: var(--space-12);
}
.barton-text {
  max-width: 560px;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
.barton-text p { color: var(--color-text-secondary); line-height: 1.6; }
.barton-text .btn { align-self: flex-start; }
</style>
