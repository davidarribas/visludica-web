---
// El componente se hidrata en el navegador: el sitio conserva output: static.
import { participationConfig } from '../data/power-ranking/participation.mjs';
---

{participationConfig.mode === 'forms' ? (
<section class="participation-card" aria-labelledby="participation-card-title">
  <div class="participation-card__copy">
    <span class="label">Participación actual</span>
    <h2 id="participation-card-title">Power Ranking</h2>
    <p>La participación directa en la web está temporalmente desactivada. Puedes participar mediante el formulario de respaldo.</p>
  </div>
  <a class="btn btn-primary participation-card__cta" href={participationConfig.formsUrl} target="_blank" rel="noreferrer">Participar con Google Forms</a>
</section>
) : participationConfig.mode === 'closed' ? (
<section class="participation-card" aria-labelledby="participation-card-title">
  <div class="participation-card__copy">
    <span class="label">Participación actual</span>
    <h2 id="participation-card-title">Power Ranking</h2>
    <p>La votación no está abierta en este momento.</p>
  </div>
</section>
) : participationConfig.mode === 'native' ? (
<section class="participation-card" data-power-ranking-participation aria-labelledby="participation-card-title">
  <div class="participation-card__copy">
    <span class="label">Participación actual</span>
    <h2 id="participation-card-title" data-participation-title>Power Ranking</h2>
    <p data-participation-status role="status" aria-live="polite">Consulta el estado de la votación.</p>
    <p class="participation-card__count" data-participation-count hidden></p>
  </div>
  <a class="btn btn-primary participation-card__cta" data-participation-cta href="/power-ranking/votar/">Consulta la votación</a>
</section>
) : null}

<script>
  import { ParticipationApiError, ParticipationClient, participationUrl } from '../lib/power-ranking/participation-client.mjs';

  const formatCloseDate = (value) => {
    try {
      return new Intl.DateTimeFormat('es-ES', {
        dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Madrid',
      }).format(new Date(value));
    } catch {
      return '';
    }
  };

  document.querySelectorAll('[data-power-ranking-participation]').forEach((root) => {
    const client = new ParticipationClient();
    const title = root.querySelector('[data-participation-title]');
    const status = root.querySelector('[data-participation-status]');
    const count = root.querySelector('[data-participation-count]');
    const cta = root.querySelector('[data-participation-cta]');
    cta.href = participationUrl(location.search);

    const setText = (node, value) => { node.textContent = value; };
    const showFallback = () => {
      setText(status, 'Consulta el estado de la votación.');
      setText(cta, 'Consulta la votación');
      count.hidden = true;
    };

    async function loadParticipation() {
      try {
        const campaign = await client.getCampaign();
        if (campaign.status !== 'open') {
          setText(title, 'Power Ranking');
          setText(status, 'Ahora no hay una votación abierta.');
          cta.hidden = true;
          count.hidden = true;
          return;
        }

        setText(title, campaign.name || 'Power Ranking');
        const closeDate = formatCloseDate(campaign.closes_at);
        setText(status, closeDate ? `Votación abierta hasta el ${closeDate}.` : 'Votación abierta.');
        setText(cta, 'Votar ahora');
        cta.hidden = false;

        try {
          const summary = await client.getSummary(campaign.campaign_id);
          if (Number.isInteger(summary.received_ballots) && summary.received_ballots >= 0) {
            setText(count, `${summary.received_ballots} papeletas recibidas en la web`);
            count.hidden = false;
          }
        } catch {
          // El contador es opcional: una campaña abierta sigue siendo útil sin él.
          count.hidden = true;
        }
      } catch (error) {
        if (error instanceof ParticipationApiError && error.code === 'NO_ACTIVE_CAMPAIGN') {
          setText(title, 'Power Ranking');
          setText(status, 'Ahora no hay una votación abierta.');
          cta.hidden = true;
          count.hidden = true;
          return;
        }
        showFallback();
      }
    }

    loadParticipation();
  });
</script>

<style>
  .participation-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }
  .participation-card h2 { margin-top: var(--space-2); font-size: var(--text-2xl); }
  .participation-card p { margin-top: var(--space-2); color: var(--color-text-secondary); }
  .participation-card__count { font-size: var(--text-sm); font-weight: var(--fw-medium); }
  .participation-card__cta { flex: 0 0 auto; }
  @media (max-width: 640px) {
    .participation-card { align-items: flex-start; flex-direction: column; gap: var(--space-4); }
    .participation-card__cta { width: 100%; text-align: center; }
  }
</style>
