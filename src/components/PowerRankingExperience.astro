---
import {
  editions,
  formatIndex,
  gameTitle,
  monthsForGame,
  presentRow,
  type ProjectId,
  type RankingView,
} from '../lib/power-ranking';

interface Props {
  edition: any;
}

const { edition } = Astro.props;
const projectIds: ProjectId[] = ['vis-ludica', 'vis-belica'];
const views: Array<{ id: RankingView; label: string; short: string }> = [
  { id: 'power', label: 'Power Ranking', short: 'Power' },
  { id: 'monthly', label: 'Ranking mensual', short: 'Este mes' },
  { id: 'analysis', label: 'Análisis', short: 'Análisis' },
  { id: 'annual', label: `Palmarés ${edition.year}`, short: 'Palmarés' },
];
const rankingViews = views.filter((view) => view.id !== 'analysis');

function scoreForRow(view: RankingView, row: any) {
  return view === 'monthly' ? String(row.points) : formatIndex(row.score);
}

function scoreLabel(view: RankingView) {
  return view === 'monthly' ? 'Puntos' : 'Índice';
}

// Normaliza para búsqueda insensible a acentos: minúsculas + sin diacríticos.
function normalizeSearch(value: string) {
  return value
    .toLocaleLowerCase('es')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');
}

// Separador de millares consistente (toLocaleString no agrupa números de 4 cifras en algunos runtimes).
const numberFormatter = new Intl.NumberFormat('es-ES', { useGrouping: 'always' });

// Texto accesible de la tira de historial (el mismo formato que se usaba
// antes de sustituir el texto por la sparkline): últimos cuatro meses.
function sparklineLabel(history: Array<number | null>, editionMonth: number) {
  return monthsForGame(history, editionMonth)
    .map((month) => `${month.label} ${month.value === null ? '—' : formatIndex(month.value)}`)
    .join(' · ');
}

// Sparkline SVG de los meses 0..editionMonth-1 del juego, normalizada entre
// el mínimo y el máximo de sus propios valores. Los meses sin datos cortan
// la línea en varios <polyline>; no se interpolan huecos.
function sparklineSvg(history: Array<number | null>, editionMonth: number) {
  const width = 120;
  const height = 28;
  const pad = 3;
  const months = history.slice(0, editionMonth);
  const values = months.filter((value): value is number => value !== null);
  const min = values.length ? Math.min(...values) : 0;
  const max = values.length ? Math.max(...values) : 0;
  const span = max - min;
  const xStep = months.length > 1 ? (width - pad * 2) / (months.length - 1) : 0;

  const points = months.map((value, index) => ({
    x: pad + index * xStep,
    y: value === null ? null : span === 0 ? height / 2 : pad + (height - pad * 2) * (1 - (value - min) / span),
  }));

  const segments: Array<Array<{ x: number; y: number }>> = [];
  let current: Array<{ x: number; y: number }> = [];
  for (const point of points) {
    if (point.y === null) {
      if (current.length) segments.push(current);
      current = [];
    } else {
      current.push({ x: point.x, y: point.y });
    }
  }
  if (current.length) segments.push(current);

  const polylines = segments
    .map((segment) => {
      const coords = segment.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ');
      return `<polyline fill="none" stroke="var(--ranking-accent)" stroke-width="1.5" stroke-linecap="round" points="${coords}" />`;
    })
    .join('');

  const lastSegment = segments.at(-1);
  const lastPoint = lastSegment?.at(-1);
  const circle = lastPoint
    ? `<circle cx="${lastPoint.x.toFixed(1)}" cy="${lastPoint.y.toFixed(1)}" r="2.5" fill="var(--ranking-accent)" />`
    : '';

  return `<svg viewBox="0 0 ${width} ${height}" width="${width}" height="${height}" aria-hidden="true">${polylines}${circle}</svg>`;
}
---

<div
  class="ranking-app"
  data-ranking-app
  data-project="vis-ludica"
  data-view="power"
  data-edition-url={`/power-ranking/${edition.year}/${String(edition.month).padStart(2, '0')}`}
>
  <section class="ranking-hero">
    <div class="container ranking-hero__inner">
      <div class="ranking-hero__copy">
        <span class="label">Clasificación de la comunidad</span>
        <h1>Power Ranking</h1>
        <p>Los juegos que están de verdad sobre la mesa. Resultados, contexto y memoria mensual de Vis Lúdica.</p>
      </div>

      <div class="edition-picker">
        <label for="ranking-edition">Edición</label>
        <select id="ranking-edition" data-edition-select>
          {editions.map((candidate) => (
            <option
              value={`/power-ranking/${candidate.year}/${String(candidate.month).padStart(2, '0')}`}
              selected={candidate.id === edition.id}
            >
              {candidate.monthName} {candidate.year}
            </option>
          ))}
        </select>
      </div>
    </div>
  </section>

  <div class="ranking-toolbar-wrap">
    <div class="container ranking-toolbar">
      <div class="project-switch" aria-label="Proyecto">
        <button type="button" data-project-button="vis-ludica" aria-pressed="true">Vis Lúdica</button>
        <button type="button" data-project-button="vis-belica" aria-pressed="false">Vis Bélica</button>
      </div>

      <div class="view-tabs" role="tablist" aria-label="Tipo de clasificación">
        {views.map((view) => (
          <button
            type="button"
            role="tab"
            aria-selected={view.id === 'power' ? 'true' : 'false'}
            data-view-button={view.id}
          >
            <span class="view-tabs__full">{view.label}</span>
            <span class="view-tabs__short">{view.short}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  {projectIds.map((projectId) => {
    const project = edition.projects[projectId];
    const copy = edition.editorial[projectId];
    const latestVoters = project.voterHistory.at(-1)?.value ?? project.stats.voters;
    const maxVoters = Math.max(...project.voterHistory.map((item: any) => item.value));
    return (
      <section class="project-view" data-project-panel={projectId} hidden={projectId !== 'vis-ludica'}>
        <div class="container edition-intro">
          <div>
            <span class="label">{copy.eyebrow}</span>
            <h2>{copy.name} · {edition.monthName} {edition.year}</h2>
            <p>{copy.intro}</p>
          </div>

          <div class="stat-grid" aria-label="Resumen de la edición">
            <div class="stat-card">
              <strong>{project.stats.voters}</strong>
              <span>{projectId === 'vis-belica' ? 'votantes de guerra' : 'votantes'}</span>
            </div>
            <div class="stat-card">
              <strong>{project.stats.distinctGames}</strong>
              <span>juegos distintos</span>
            </div>
            <div class="stat-card">
              <strong>{numberFormatter.format(project.stats.totalPoints)}</strong>
              <span>puntos repartidos</span>
            </div>
          </div>
        </div>

        {projectId === 'vis-belica' && (
          <div class="container voter-growth">
            <div class="voter-growth__heading">
              <div>
                <span class="label">{copy.voterGrowth?.label ?? 'Evolución de la comunidad'}</span>
                <h3>{copy.voterGrowth?.headline ?? `De 15 a ${latestVoters} votantes`}</h3>
              </div>
              <p>{copy.voterGrowth?.deck ?? 'La muestra sigue construyendo su histórico mes a mes.'}</p>
            </div>
            <ol class="voter-bars" aria-label="Evolución de votantes de guerra">
              {project.voterHistory.map((item: any) => (
                <li>
                  <span class="voter-bars__value">{item.value}</span>
                  <span class="voter-bars__track" aria-hidden="true">
                    <span style={`--bar-size: ${(item.value / maxVoters) * 100}%`}></span>
                  </span>
                  <span class="voter-bars__label">{item.label}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        {rankingViews.map((view) => {
          const rows = project.rankings[view.id];
          const podium = rows.slice(0, 3);
          // Solo se renderizan estáticamente las primeras 100 filas; el resto
          // llega bajo demanda vía datos.json (ver ensureFullData en el script).
          const staticRows = rows.slice(0, 100);
          const viewCopy = copy[view.id];
          return (
            <div class="ranking-view" data-view-panel={view.id} hidden={view.id !== 'power'}>
              <section class="container story-lead">
                <span class="label">{view.label}</span>
                <h2>{viewCopy.headline}</h2>
                <p>{viewCopy.deck}</p>
              </section>

              <section class="container podium" aria-label={`Podio de ${view.label}`}>
                {podium.map((row: any, index: number) => {
                  const title = row.title ?? gameTitle(project, row.id);
                  const note = viewCopy.notes?.[row.id];
                  const history = project.games[row.id]?.history ?? [];
                  return (
                    <article class:list={['podium-card', `podium-card--${index + 1}`]}>
                      <div class="podium-card__top">
                        <span class="podium-position">{index + 1}</span>
                        <span class="podium-score">
                          <strong>{scoreForRow(view.id, row)}</strong>
                          <small>{scoreLabel(view.id)}</small>
                        </span>
                      </div>
                      <h3>{title}</h3>
                      {view.id === 'monthly' && (
                        <p class="vote-breakdown">
                          {row.firstVotes}–{row.secondVotes}–{row.thirdVotes} · {row.votes} votantes
                        </p>
                      )}
                      {view.id !== 'monthly' && (
                        <ul class="month-strip" aria-label="Últimos cuatro meses">
                          {monthsForGame(history, edition.month).map((month) => (
                            <li class:list={{ 'month-strip--empty': month.value === null }}>
                              <span>{month.label}</span>
                              <strong>{month.value === null ? '—' : formatIndex(month.value)}</strong>
                            </li>
                          ))}
                        </ul>
                      )}
                      {note && <p class="podium-card__note">{note}</p>}
                    </article>
                  );
                })}
              </section>

              {'afterword' in viewCopy && viewCopy.afterword && (
                <aside class="container field-note">
                  <span>Zona noble</span>
                  <p>{viewCopy.afterword}</p>
                </aside>
              )}

              <section class="container ranking-table-section">
                <div class="ranking-table-heading">
                  <div>
                    <span class="label">Clasificación completa</span>
                    <h2>{view.label}</h2>
                  </div>
                  <label class="ranking-search">
                    <span class="sr-only">Buscar juego</span>
                    <input type="search" placeholder="Buscar un juego…" data-ranking-search />
                  </label>
                </div>

                <div class="ranking-table-shell" data-table-shell data-page-size="25" data-total-count={rows.length}>
                  <div class="ranking-table-scroll">
                    <table>
                      <thead>
                        <tr>
                          <th scope="col" class="col-rank">Pos.</th>
                          <th scope="col">Juego</th>
                          <th scope="col" class="col-score">{scoreLabel(view.id)}</th>
                          {view.id === 'monthly' && <th scope="col" class="col-detail">1º–2º–3º</th>}
                          {view.id === 'monthly' && <th scope="col" class="col-detail">Votos</th>}
                          {view.id === 'annual' && <th scope="col" class="col-detail">Meses</th>}
                          <th scope="col" class="col-movement">Mov.</th>
                        </tr>
                      </thead>
                      <tbody>
                        {staticRows.map((row: any, index: number) => {
                          const presented = presentRow(project, view.id, row, edition.month);
                          const history = project.games[row.id]?.history ?? [];
                          return (
                            <tr
                              data-ranking-row
                              data-search-value={normalizeSearch(presented.title)}
                              data-row-index={index}
                              hidden={index >= 25}
                            >
                              <td class="col-rank"><span>{presented.rank}</span></td>
                              <th scope="row">
                                <strong>{presented.title}</strong>
                                {view.id !== 'monthly' && index < 10 && (
                                  <span
                                    class="table-history"
                                    role="img"
                                    aria-label={sparklineLabel(history, edition.month)}
                                    set:html={sparklineSvg(history, edition.month)}
                                  />
                                )}
                              </th>
                              <td class="col-score"><strong>{view.id === 'monthly' ? presented.points : presented.score}</strong></td>
                              {view.id === 'monthly' && (
                                <td class="col-detail">{presented.detail}</td>
                              )}
                              {view.id === 'monthly' && <td class="col-detail">{presented.votes}</td>}
                              {view.id === 'annual' && <td class="col-detail">{presented.months}</td>}
                              <td class="col-movement">
                                <span class:list={['movement', `movement--${presented.movement.tone}`]}>{presented.movement.label}</span>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                  <div class="table-footer">
                    <span data-result-count>{Math.min(25, rows.length)} de {rows.length} juegos</span>
                    {rows.length > 25 && <button type="button" data-show-more>Mostrar 25 más</button>}
                  </div>
                </div>
              </section>

              {view.id === 'monthly' && copy.quotes.length > 0 && (
                <section class="community-voices">
                  <div class="container">
                    <div class="voices-heading">
                      <span class="label">La grada</span>
                      <h2>Lo mejor de las papeletas</h2>
                      <p>Comentarios, confesiones y pequeñas historias que explican mejor el mes que cualquier decimal.</p>
                    </div>
                    <div class="quotes-grid">
                      {copy.quotes.map((quote: any) => (
                        <blockquote>
                          <span>{quote.label}</span>
                          <p>“{quote.text}”</p>
                          {quote.attribution && <cite>{quote.attribution}</cite>}
                        </blockquote>
                      ))}
                    </div>
                  </div>
                </section>
              )}
            </div>
          );
        })}

        <div class="ranking-view analysis-view" data-view-panel="analysis" hidden>
          {copy.chronicle ? (
            <section class="monthly-chronicle" aria-labelledby={`chronicle-${projectId}-${edition.id}`}>
              <div class="container chronicle-layout">
                <article class="chronicle-article">
                  <header class="chronicle-header">
                    <span class="label">{copy.chronicle.eyebrow}</span>
                    <h2 id={`chronicle-${projectId}-${edition.id}`}>{copy.chronicle.headline}</h2>
                    <p class="chronicle-deck">{copy.chronicle.deck}</p>
                    <div class="chronicle-intro">
                      {copy.chronicle.intro.map((paragraph: string) => <p>{paragraph}</p>)}
                    </div>
                  </header>

                  <div class="chronicle-body">
                    {copy.chronicle.sections.map((section: any) => (
                      <section>
                        <h3>{section.title}</h3>
                        {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                      </section>
                    ))}
                  </div>
                </article>

                <aside class="chronicle-aside" aria-label="Datos y voces del mes">
                  {copy.chronicle.sidebar.map((item: any) => (
                    <div class="chronicle-note">
                      <span>{item.title}</span>
                      <p>{item.text}</p>
                    </div>
                  ))}

                  <div class="chronicle-voices">
                    <span class="label">La grada</span>
                    <h3>Las frases de {edition.monthName.toLowerCase()}</h3>
                    {copy.chronicle.voices.map((voice: any) => (
                      <blockquote>
                        <p>“{voice.text}”</p>
                        <cite>{voice.attribution}</cite>
                      </blockquote>
                    ))}
                  </div>
                </aside>
              </div>

              <div class="container">
                <aside class="chronicle-discussion">
                  <div>
                    <span class="label">Sigue la conversación</span>
                    <h3>{copy.chronicle.discussion.headline}</h3>
                    <p>{copy.chronicle.discussion.text}</p>
                  </div>
                  <a
                    href={copy.chronicle.discussion.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {copy.chronicle.discussion.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                </aside>
              </div>
            </section>
          ) : (
            <section class="container analysis-empty">
              <span class="label">Análisis mensual</span>
              <h2>La crónica de esta edición está en preparación</h2>
              <p>Los datos ya están publicados. Añadiremos aquí la lectura editorial, las historias y las voces de la comunidad.</p>
            </section>
          )}
        </div>

        <section class="container methodology">
          <details>
            <summary>Cómo se calcula</summary>
            <div>
              <p>{copy.methodology}</p>
              <p><strong>POWER</strong> = 0,7 × mes actual + 0,3 × (0,5 × mes anterior + 0,3 × hace dos meses + 0,2 × hace tres meses).</p>
              <p><strong>Palmarés</strong> = suma de los valores normalizados de todos los meses del año, sin decaimiento.</p>
            </div>
          </details>
        </section>
      </section>
    );
  })}
</div>

<script>
  const apps = document.querySelectorAll<HTMLElement>('[data-ranking-app]');

  apps.forEach((app) => {
    const projectButtons = app.querySelectorAll<HTMLButtonElement>('[data-project-button]');
    const viewButtons = app.querySelectorAll<HTMLButtonElement>('[data-view-button]');
    const projectPanels = app.querySelectorAll<HTMLElement>('[data-project-panel]');
    const editionSelect = app.querySelector<HTMLSelectElement>('[data-edition-select]');
    const params = new URLSearchParams(window.location.search);
    let activeProject = params.get('proyecto') === 'vis-belica' ? 'vis-belica' : 'vis-ludica';
    const requestedView = params.get('vista');
    let activeView = ['power', 'monthly', 'analysis', 'annual'].includes(requestedView ?? '') ? requestedView! : 'power';

    function updateUrl() {
      const next = new URL(window.location.href);
      if (activeProject === 'vis-ludica') next.searchParams.delete('proyecto');
      else next.searchParams.set('proyecto', activeProject);
      if (activeView === 'power') next.searchParams.delete('vista');
      else next.searchParams.set('vista', activeView);
      history.replaceState({}, '', next);
    }

    function renderState() {
      app.dataset.project = activeProject;
      app.dataset.view = activeView;
      projectButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.projectButton === activeProject));
      });
      viewButtons.forEach((button) => {
        button.setAttribute('aria-selected', String(button.dataset.viewButton === activeView));
      });
      projectPanels.forEach((panel) => {
        const isProject = panel.dataset.projectPanel === activeProject;
        panel.hidden = !isProject;
        panel.querySelectorAll<HTMLElement>('[data-view-panel]').forEach((view) => {
          view.hidden = !isProject || view.dataset.viewPanel !== activeView;
        });
      });
      updateUrl();
    }

    projectButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeProject = button.dataset.projectButton!;
        renderState();
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeView = button.dataset.viewButton!;
        renderState();
      });
    });

    editionSelect?.addEventListener('change', () => {
      const target = new URL(editionSelect.value, window.location.href);
      if (activeProject !== 'vis-ludica') target.searchParams.set('proyecto', activeProject);
      if (activeView !== 'power') target.searchParams.set('vista', activeView);
      window.location.href = target.toString();
    });

    app.querySelectorAll<HTMLElement>('[data-table-shell]').forEach((shell) => {
      const rows = Array.from(shell.querySelectorAll<HTMLTableRowElement>('[data-ranking-row]'));
      const search = shell.closest('.ranking-table-section')?.querySelector<HTMLInputElement>('[data-ranking-search]');
      const showMore = shell.querySelector<HTMLButtonElement>('[data-show-more]');
      const resultCount = shell.querySelector<HTMLElement>('[data-result-count]');
      const pageSize = Number(shell.dataset.pageSize ?? 25);
      const totalCount = Number(shell.dataset.totalCount ?? rows.length);
      const projectId = shell.closest<HTMLElement>('[data-project-panel]')?.dataset.projectPanel;
      const viewId = shell.closest<HTMLElement>('[data-view-panel]')?.dataset.viewPanel;
      let visibleLimit = pageSize;

      function normalizeSearch(value: string) {
        return value
          .toLocaleLowerCase('es')
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '');
      }

      // Sólo las 100 primeras filas de cada vista llegan pintadas en el HTML
      // estático; el resto (rank > 100) se pide una vez a datos.json y se
      // inserta como texto (nada de innerHTML con datos externos).
      function buildRow(rowData: any): HTMLTableRowElement {
        const tr = document.createElement('tr');
        tr.hidden = true;
        tr.dataset.rankingRow = '';
        tr.dataset.searchValue = normalizeSearch(String(rowData.title ?? ''));

        const tdRank = document.createElement('td');
        tdRank.className = 'col-rank';
        const rankSpan = document.createElement('span');
        rankSpan.textContent = String(rowData.rank);
        tdRank.appendChild(rankSpan);
        tr.appendChild(tdRank);

        const th = document.createElement('th');
        th.setAttribute('scope', 'row');
        const titleStrong = document.createElement('strong');
        titleStrong.textContent = String(rowData.title ?? '');
        th.appendChild(titleStrong);
        tr.appendChild(th);

        const tdScore = document.createElement('td');
        tdScore.className = 'col-score';
        const scoreStrong = document.createElement('strong');
        scoreStrong.textContent = String(viewId === 'monthly' ? rowData.points : rowData.score);
        tdScore.appendChild(scoreStrong);
        tr.appendChild(tdScore);

        if (viewId === 'monthly') {
          const tdDetail = document.createElement('td');
          tdDetail.className = 'col-detail';
          tdDetail.textContent = String(rowData.detail ?? '');
          tr.appendChild(tdDetail);

          const tdVotes = document.createElement('td');
          tdVotes.className = 'col-detail';
          tdVotes.textContent = String(rowData.votes ?? '');
          tr.appendChild(tdVotes);
        }

        if (viewId === 'annual') {
          const tdMonths = document.createElement('td');
          tdMonths.className = 'col-detail';
          tdMonths.textContent = String(rowData.months ?? '');
          tr.appendChild(tdMonths);
        }

        const tdMovement = document.createElement('td');
        tdMovement.className = 'col-movement';
        const movementSpan = document.createElement('span');
        const tone = rowData.movement?.tone ?? 'same';
        movementSpan.className = `movement movement--${tone}`;
        movementSpan.textContent = rowData.movement?.label ?? '—';
        tdMovement.appendChild(movementSpan);
        tr.appendChild(tdMovement);

        return tr;
      }

      let fullDataPromise: Promise<void> | null = null;
      function ensureFullData(): Promise<void> {
        if (fullDataPromise) return fullDataPromise;
        fullDataPromise = (async () => {
          const editionUrl = app.dataset.editionUrl;
          if (!editionUrl || !projectId || !viewId) return;
          try {
            const response = await fetch(`${editionUrl}/datos.json`);
            if (!response.ok) throw new Error(`Respuesta ${response.status}`);
            const payload = await response.json();
            const viewRows = payload?.[projectId]?.[viewId];
            if (!Array.isArray(viewRows)) return;
            const tbody = shell.querySelector('tbody');
            if (!tbody) return;
            for (const rowData of viewRows.slice(rows.length)) {
              const tr = buildRow(rowData);
              tbody.appendChild(tr);
              rows.push(tr);
            }
          } catch (error) {
            console.warn('No se pudo cargar el listado completo del ranking', error);
          }
        })();
        return fullDataPromise;
      }

      function filterRows() {
        const query = normalizeSearch(search?.value.trim() ?? '');
        const matches = rows.filter((row) => row.dataset.searchValue?.includes(query));
        // Antes de cargar datos.json, `rows` solo tiene las filas estáticas
        // (hasta 100): usar el total real (data-total-count) evita que el
        // contador mienta y que el botón desaparezca antes de tiempo.
        const total = query === '' ? Math.max(totalCount, matches.length) : matches.length;
        rows.forEach((row) => {
          const matchIndex = matches.indexOf(row);
          row.hidden = matchIndex === -1 || matchIndex >= visibleLimit;
        });
        if (resultCount) resultCount.textContent = `${Math.min(visibleLimit, total)} de ${total} juegos`;
        if (showMore) {
          showMore.hidden = visibleLimit >= total;
          showMore.textContent = `Mostrar ${Math.min(pageSize, Math.max(0, total - visibleLimit))} más`;
        }
      }

      search?.addEventListener('input', () => {
        visibleLimit = pageSize;
        ensureFullData().then(filterRows);
      });
      showMore?.addEventListener('click', async () => {
        const nextLimit = visibleLimit + pageSize;
        if (nextLimit > rows.length) {
          await ensureFullData();
        }
        visibleLimit = nextLimit;
        filterRows();
      });
    });

    renderState();
  });
</script>

