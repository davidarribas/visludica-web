---
import type { NewsCardViewModel } from '../lib/news';

interface Props {
  news: NewsCardViewModel;
}

const { news } = Astro.props;
const href = `/noticias/${news.slug}/`;
---

<article class:list={['news-card', { 'news-card--without-image': !news.image }]}>
  {news.image && (
    <a href={href} class="news-card__image-link" aria-label={`Leer: ${news.title}`}>
      <img
        src={news.image.src}
        alt={news.image.alt}
        class="news-card__image"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <div class="news-card__body">
    <div class="news-card__meta">
      <time datetime={news.publishedAt}>{news.publishedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{news.productContext}</span>
    </div>
    <h2 class="news-card__title"><a href={href}>{news.title}</a></h2>
    <p class="news-card__summary">{news.summary}</p>
    <a href={href} class="news-card__cta">Leer noticia <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
.news-card {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: var(--space-5);
  padding: var(--space-5);
  background: var(--color-surface);
  border: var(--border);
  box-shadow: var(--shadow-md);
  transition: transform var(--transition), box-shadow var(--transition);
}
.news-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--shadow-lg);
}
.news-card--without-image { grid-template-columns: minmax(0, 1fr); }
.news-card__image-link {
  align-self: start;
  aspect-ratio: 1;
  overflow: hidden;
  border: var(--border-thin);
  background: var(--color-surface-raised);
}
.news-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.news-card__body {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
}
.news-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
  font-size: var(--text-meta);
  text-transform: uppercase;
}
.news-card__title {
  font-size: var(--text-xl);
  line-height: 1.1;
}
.news-card__title a { color: var(--color-text); }
.news-card__title a:hover { color: var(--color-accent); }
.news-card__summary {
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
  line-height: 1.55;
}
.news-card__cta {
  margin-top: auto;
  color: var(--color-accent);
  font-size: var(--text-sm);
  font-weight: var(--fw-bold);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 4px;
}
.news-card__cta:hover { color: var(--color-accent-hover); text-decoration-thickness: 3px; }

@media (max-width: 640px) {
  .news-card { grid-template-columns: 112px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-4); }
  .news-card--without-image { grid-template-columns: minmax(0, 1fr); }
  .news-card__image-link { aspect-ratio: 1; }
  .news-card__title { font-size: var(--text-lg); }
}
</style>
