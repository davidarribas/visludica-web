---
import { formatNewsDate, type NewsCardViewModel } from '../lib/news';

interface Props {
  news: NewsCardViewModel;
}

const { news } = Astro.props;
const href = `/noticias/${news.slug}`;
---

<article class:list={['news-card', { 'news-card--without-image': !news.image }]}>
  {news.image && (
    <a href={href} class="news-card__image-link" aria-label={`Leer: ${news.title}`}>
      <img
        src={news.image.src}
        alt={news.image.alt}
        class="news-card__image"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <div class="news-card__body">
    <div class="news-card__meta">
      {news.date ? (
        <time datetime={news.date.toISOString()}>{formatNewsDate(news.date)}</time>
      ) : (
        <span>Fecha editorial sin confirmar</span>
      )}
      <span aria-hidden="true">·</span>
      <span>{news.eventLabel}</span>
      <span aria-hidden="true">·</span>
      <span>{news.productContext}</span>
    </div>
    <h2 class="news-card__title"><a href={href}>{news.title}</a></h2>
    <p class="news-card__summary">{news.summary}</p>
    <a href={href} class="news-card__cta">Leer noticia <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
.news-card {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: var(--space-5);
  padding: var(--space-5);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: border-color var(--transition), box-shadow var(--transition);
}
.news-card:hover {
  border-color: var(--color-border-strong);
  box-shadow: var(--shadow-md);
}
.news-card--without-image { grid-template-columns: minmax(0, 1fr); }
.news-card__image-link {
  align-self: stretch;
  min-height: 132px;
  overflow: hidden;
  border-radius: var(--radius-md);
  background: var(--color-surface-raised);
}
.news-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.news-card__body {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
}
.news-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  color: var(--color-text-secondary);
  font-size: var(--text-xs);
}
.news-card__title {
  font-size: var(--text-xl);
  line-height: 1.25;
}
.news-card__title a { color: var(--color-text); }
.news-card__title a:hover { color: var(--color-accent); }
.news-card__summary {
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
  line-height: 1.55;
}
.news-card__cta {
  margin-top: auto;
  color: var(--color-accent);
  font-size: var(--text-sm);
  font-weight: var(--fw-medium);
}
.news-card__cta:hover { color: var(--color-accent-hover); }

@media (max-width: 640px) {
  .news-card { grid-template-columns: 112px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-4); }
  .news-card--without-image { grid-template-columns: minmax(0, 1fr); }
  .news-card__image-link { min-height: 112px; }
  .news-card__title { font-size: var(--text-lg); }
}
</style>
