---
import type { Episode } from '../lib/rss';

interface Props {
  episode: Episode;
  featured?: boolean;
}

const { episode, featured = false } = Astro.props;

const formattedDate = episode.pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const shortDescription = episode.description.length > 160
  ? episode.description.slice(0, 157) + '…'
  : episode.description;
---

<article class:list={['episode-card', { 'episode-card--featured': featured }]}>
  <a href={`/podcast/${episode.slug}`} class="episode-card__link" tabindex="-1" aria-hidden="true">
    <div class="episode-card__image-wrap">
      {episode.imageUrl
        ? <img src={episode.imageUrl} alt="" width="200" height="200" loading="lazy" decoding="async" />
        : <div class="episode-card__image-placeholder" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/></svg>
          </div>
      }
    </div>
  </a>

  <div class="episode-card__body">
    <div class="episode-card__meta">
      <time datetime={episode.pubDate.toISOString()} class="text-xs text-secondary">{formattedDate}</time>
      {episode.duration && (
        <span class="episode-card__duration text-xs text-secondary">· {episode.duration}</span>
      )}
    </div>
    <h3 class="episode-card__title">
      <a href={`/podcast/${episode.slug}`}>{episode.title}</a>
    </h3>
    {shortDescription && (
      <p class="episode-card__desc text-secondary">{shortDescription}</p>
    )}
    <a href={`/podcast/${episode.slug}`} class="episode-card__cta">
      Escuchar episodio →
    </a>
  </div>
</article>

<style>
.episode-card {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: var(--space-4);
  padding: var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: box-shadow var(--transition), border-color var(--transition);
}
.episode-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--color-border-strong);
}
.episode-card--featured {
  grid-template-columns: 140px 1fr;
  padding: var(--space-6);
}

.episode-card__link { display: block; }
.episode-card__image-wrap {
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-surface-raised);
  flex-shrink: 0;
}
.episode-card__image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.episode-card__image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
}

.episode-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-width: 0;
}
.episode-card__meta {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}
.episode-card__title {
  font-size: var(--text-base);
  font-weight: var(--fw-bold);
  line-height: 1.3;
}
.episode-card--featured .episode-card__title {
  font-size: var(--text-xl);
}
.episode-card__title a {
  text-decoration: none;
  color: var(--color-text);
  transition: color var(--transition);
}
.episode-card__title a:hover { color: var(--color-accent); }

.episode-card__desc {
  font-size: var(--text-sm);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.episode-card--featured .episode-card__desc {
  -webkit-line-clamp: 3;
}

.episode-card__cta {
  display: inline-block;
  margin-top: auto;
  font-size: var(--text-xs);
  font-weight: var(--fw-medium);
  color: var(--color-accent);
  text-decoration: none;
  transition: gap var(--transition);
}
.episode-card__cta:hover { color: var(--color-accent-hover); }

@media (max-width: 480px) {
  .episode-card { grid-template-columns: 80px 1fr; }
  .episode-card--featured { grid-template-columns: 80px 1fr; }
}
</style>
